# OpenRouter API Keys (get from https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your_api_key_here
OPENROUTER_INVOICE_KEY=sk-or-v1-your_invoice_key_here
OPENROUTER_MODEL=openai/gpt-oss-20b:free
INVOICE_MODEL=openai/gpt-oss-20b:free

# Groq Cloud API Key (kept for fallback)
GROQ_API_KEY=gsk_your_api_key_here

# AI System Prompt (customize your bot's personality)
SYSTEM_PROMPT=You are a friendly WhatsApp assistant for Stratix Agency.

# Anti-ban settings
MIN_DELAY_MS=2000
MAX_DELAY_MS=4000
MAX_MESSAGES_PER_MINUTE=20

# AI disclosure: how many times user asks before admitting being AI
AI_ASK_LIMIT=3
