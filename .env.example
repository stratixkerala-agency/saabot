# Groq Cloud API Key (get from https://console.groq.com)
GROQ_API_KEY=gsk_your_api_key_here

# AI System Prompt (customize your bot's personality)
SYSTEM_PROMPT=You are a friendly and helpful WhatsApp assistant. Keep replies concise and conversational. Never use markdown formatting since this is WhatsApp.

# Anti-ban settings
MIN_DELAY_MS=2000
MAX_DELAY_MS=4000
MAX_MESSAGES_PER_MINUTE=20

# Model to use (llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it)
GROQ_MODEL=llama-3.1-8b-instant
